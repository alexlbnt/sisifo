# Copie para .env.local (desenvolvimento). Na Vercel, cadastre em Settings → Environment Variables.

# Conexão com o Postgres. Na Vercel, a integração do Neon cria esta variável sozinha.
# Localmente: use `npx prisma dev --name sisifo --detach` e cole a URL TCP que ele mostrar.
DATABASE_URL=

# Gere as duas com: npm run hash-password
SISIFO_PASSWORD_HASH=
SESSION_SECRET=
