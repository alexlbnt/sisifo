# Copie para .env.local (desenvolvimento). Na Vercel, cadastre em Settings → Environment Variables.

# Conexão com o Postgres. Na Vercel, a integração do Neon cria esta variável sozinha.
# Localmente: use `npx prisma dev --name sisifo --detach` e cole a URL TCP que ele mostrar.
DATABASE_URL=

# Gere as duas com: npm run hash-password
SISIFO_PASSWORD_HASH=
SESSION_SECRET=

# Notificações push (opcional). Gere as chaves com: npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seu-email@exemplo.com

# Protege o agendamento das notificações (/api/notify). Na Vercel, a chamada do cron já envia este segredo.
# Gere um valor longo e aleatório, ex.: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=

# Backup automático semanal (opcional). Na Vercel: Storage → Create → Blob, acesso **Private**, e conecte
# ao projeto. A SDK usa OIDC sozinha (BLOB_STORE_ID é criada na conexão); nada para colar aqui.
# Só para testar o backup no `npm run dev`: o token de leitura e escrita do store.
BLOB_READ_WRITE_TOKEN=

# Agenda do Modo Painel (opcional). Google Calendar → Configurações do calendário →
# "Endereço secreto no formato iCal". Só o servidor lê; para revogar, use "Redefinir" no Google.
# Vários calendários: separe por vírgula.
GOOGLE_ICAL_URL=
