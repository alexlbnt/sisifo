// Banco do Sísifo (Neon Postgres). O app é local-first: cada item salvo no
// aparelho vira um registro aqui, e os aparelhos trocam alterações pelo `seq`.

generator client {
  provider            = "prisma-client"
  output              = "../server/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// Um item de uma coleção (transação, meta, hábito...) guardado como JSON.
model SyncRecord {
  collection String
  id         String
  /// null = item excluído (fica como "lápide" para os outros aparelhos saberem).
  data       Json?
  /// Momento da alteração no aparelho. A alteração mais recente vence.
  updatedAt  DateTime @db.Timestamptz(3)
  /// Contador global: muda a cada escrita. É o cursor da sincronização.
  seq        BigInt   @default(autoincrement())

  @@id([collection, id])
  @@index([seq])
  @@map("sync_records")
}

/// Tentativas de login, para limitar quem tenta adivinhar a senha.
model LoginAttempt {
  id        Int      @id @default(autoincrement())
  ip        String
  ok        Boolean
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([ip, createdAt])
  @@map("login_attempts")
}

/// Um aparelho inscrito para receber notificações (Web Push).
model PushSubscription {
  /// URL do serviço de push do navegador; identifica o aparelho.
  endpoint  String   @id
  p256dh    String
  auth      String
  /// Fuso do aparelho (ex.: America/Sao_Paulo), para calcular o "hoje" certo.
  timeZone  String
  /// Quais avisos o aparelho quer receber.
  prefs     Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("push_subscriptions")
}

/// Chave de acesso de um Atalho do iPhone (ou outra automação). Só o hash fica no banco.
model ApiToken {
  id         String    @id
  /// Nome dado pela pessoa (ex.: "iPhone").
  name       String
  /// SHA-256 da chave. A chave em si só aparece uma vez, ao ser criada.
  tokenHash  String    @unique
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  lastUsedAt DateTime? @db.Timestamptz(3)

  @@map("api_tokens")
}

/// Erro registrado pelo app ou pela API. Sem dados pessoais: só a mensagem
/// (limpa de números e textos longos), a pilha, a rota, a versão e o tipo de aparelho.
model ErrorLog {
  id          String   @id
  /// Mesmo erro (tipo + mensagem + primeira linha da pilha) soma em `count`.
  fingerprint String   @unique
  /// window | promise | sync | api
  kind        String
  message     String
  stack       String?
  route       String?
  appVersion  String?
  device      String?
  /// SHA-256 do IP de quem enviou por último: só para o limite de envios.
  ipHash      String
  count       Int      @default(1)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  lastSeenAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([ipHash, lastSeenAt])
  @@index([lastSeenAt])
  @@map("error_logs")
}
