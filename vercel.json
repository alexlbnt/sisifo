{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "rewrites": [
    {
      "source": "/painel",
      "destination": "/painel.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/notify?slot=morning",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/notify?slot=evening",
      "schedule": "0 23 * * *"
    }
  ]
}
