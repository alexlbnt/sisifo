{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sísifo",
  "version": "0.1.0",
  "identifier": "app.sisifo.desktop",
  "build": {
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "..",
      "wait": false
    },
    "frontendDist": "offline"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": [
        "main"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM4QkIwQjY0MjRFNzlDN0MKUldSOG5PY2taQXU3T0YzSFp3V0dETFh4cEl2RmJXc1FBWHdrb00wYkdGd2FpRmhwbUYxdHlteUYK",
      "endpoints": [
        "https://github.com/alexlbnt/sisifo/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
